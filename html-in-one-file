<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Defines the character encoding -->
    <meta charset="UTF-8">

    <!-- Makes the page responsive on mobile devices -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Text shown in the browser tab -->
    <title>HTML Learning Page</title>

    <!-- Short description of the webpage -->
    <meta name="description" content="A complete HTML learning example covering important HTML tags.">
</head>

<body>

    <!-- =========================================================
         HEADER
         Used for the introductory content of a webpage/section.
         ========================================================= -->
    <header>

        <!-- h1 is the main heading of the entire webpage -->
        <h1>HTML Learning Guide</h1>

        <!-- p is used for a paragraph of text -->
        <p>
            Welcome! This page demonstrates the most important
            HTML tags that every beginner should understand.
        </p>

        <!-- nav contains navigation links -->
        <nav>
            <a href="#about">About</a> |
            <a href="#topics">Topics</a> |
            <a href="#table">Table</a> |
            <a href="#contact">Contact</a>
        </nav>

    </header>


    <!-- =========================================================
         MAIN
         Contains the primary content of the webpage.
         A page should normally have one main element.
         ========================================================= -->
    <main>

        <!-- section groups related content together -->
        <section id="about">

            <h2>About HTML</h2>

            <p>
                <strong>HTML</strong> stands for
                <em>HyperText Markup Language</em>.
                It is used to structure content on the web.
            </p>

            <!-- br creates a line break -->
            <p>
                HTML gives structure to a webpage.<br>
                CSS gives it visual styling.<br>
                JavaScript gives it behavior.
            </p>

            <!-- hr represents a thematic break between content -->
            <hr>

        </section>


        <!-- =====================================================
             HEADINGS
             h1 is the most important heading.
             h2-h6 represent lower levels of headings.
             ===================================================== -->
        <section>

            <h2>Heading Levels</h2>

            <h3>Heading 3</h3>
            <h4>Heading 4</h4>
            <h5>Heading 5</h5>
            <h6>Heading 6</h6>

        </section>


        <!-- =====================================================
             TEXT FORMATTING
             ===================================================== -->
        <section>

            <h2>Text Formatting</h2>

            <!-- strong means strong importance -->
            <p>This is <strong>important text</strong>.</p>

            <!-- em represents emphasized text -->
            <p>This is <em>emphasized text</em>.</p>

            <!-- mark highlights text -->
            <p>This is <mark>highlighted text</mark>.</p>

            <!-- small represents side comments or less important text -->
            <p><small>This is smaller text.</small></p>

            <!-- del represents deleted text -->
            <p>Old price: <del>₹999</del></p>

            <!-- ins represents inserted text -->
            <p>New price: <ins>₹699</ins></p>

            <!-- sub is used for subscript -->
            <p>Water formula: H<sub>2</sub>O</p>

            <!-- sup is used for superscript -->
            <p>2<sup>2</sup> = 4</p>

            <!-- code represents a piece of computer code -->
            <p>Use <code>&lt;h1&gt;</code> for a main heading.</p>

            <!-- pre preserves spaces and line breaks -->
            <pre>
This text
keeps its
original formatting.
            </pre>

        </section>


        <!-- =====================================================
             LISTS
             ===================================================== -->
        <section id="topics">

            <h2>HTML Topics</h2>

            <!-- ul creates an unordered/bullet list -->
            <h3>Unordered List</h3>

            <ul>
                <li>HTML</li>
                <li>CSS</li>
                <li>JavaScript</li>
            </ul>


            <!-- ol creates an ordered/numbered list -->
            <h3>Ordered List</h3>

            <ol>
                <li>Learn HTML</li>
                <li>Learn CSS</li>
                <li>Learn JavaScript</li>
            </ol>


            <!-- dl creates a description list -->
            <h3>Description List</h3>

            <dl>

                <!-- dt is the term -->
                <dt>HTML</dt>

                <!-- dd describes the term -->
                <dd>Used to structure webpages.</dd>

                <dt>CSS</dt>
                <dd>Used to style webpages.</dd>

            </dl>

        </section>


        <!-- =====================================================
             LINKS
             ===================================================== -->
        <section>

            <h2>Links</h2>

            <!-- a creates a hyperlink -->
            <p>
                Visit
                <a href="https://www.google.com" target="_blank">
                    Google
                </a>
            </p>

            <!-- target="_blank" opens the link in a new tab -->

        </section>


        <!-- =====================================================
             IMAGE
             ===================================================== -->
        <section>

            <h2>Image</h2>

            <!--
                img displays an image.
                src = image location
                alt = alternative text for accessibility
            -->
            <img
                src="https://via.placeholder.com/300"
                alt="Example placeholder image"
                width="300"
            >

        </section>


        <!-- =====================================================
             FIGURE
             figure groups an image/media with its caption.
             ===================================================== -->
        <section>

            <h2>Figure</h2>

            <figure>

                <img
                    src="https://via.placeholder.com/250"
                    alt="Example figure"
                    width="250"
                >

                <!-- figcaption describes the figure -->
                <figcaption>
                    An example image with a caption.
                </figcaption>

            </figure>

        </section>


        <!-- =====================================================
             TABLE
             ===================================================== -->
        <section id="table">

            <h2>Student Table</h2>

            <!-- table represents tabular data -->
            <table border="1">

                <!-- caption gives the table a title -->
                <caption>Student Information</caption>

                <!-- thead contains table headings -->
                <thead>

                    <tr>
                        <!-- th represents a table heading -->
                        <th>Name</th>
                        <th>Age</th>
                        <th>Course</th>
                    </tr>

                </thead>

                <!-- tbody contains the main table data -->
                <tbody>

                    <tr>
                        <!-- td represents table data -->
                        <td>Amar</td>
                        <td>20</td>
                        <td>Web Development</td>
                    </tr>

                    <tr>
                        <td>Rahul</td>
                        <td>21</td>
                        <td>Computer Science</td>
                    </tr>

                </tbody>

                <!-- tfoot contains summary/footer information -->
                <tfoot>

                    <tr>
                        <td colspan="3">
                            Total Students: 2
                        </td>
                    </tr>

                </tfoot>

            </table>

        </section>


        <!-- =====================================================
             FORM
             ===================================================== -->
        <section id="contact">

            <h2>Contact Form</h2>

            <!--
                form collects information from the user.
                action specifies where the form data should be sent.
                method specifies how the data should be sent.
            -->
            <form action="#" method="post">

                <!-- label describes an input -->
                <label for="name">Full Name:</label>

                <!--
                    input creates an input field.
                    id connects the input with its label.
                    name identifies the data when submitted.
                -->
                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Enter your name"
                    required
                >

                <br><br>


                <label for="email">Email:</label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email"
                    required
                >

                <br><br>


                <!-- password hides the entered characters -->
                <label for="password">Password:</label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    required
                >

                <br><br>


                <!-- radio buttons allow one choice from a group -->
                <p>Choose your gender:</p>

                <input
                    type="radio"
                    id="male"
                    name="gender"
                    value="male"
                >

                <label for="male">Male</label>

                <input
                    type="radio"
                    id="female"
                    name="gender"
                    value="female"
                >

                <label for="female">Female</label>

                <br><br>


                <!-- checkbox allows multiple selections -->
                <p>Choose your skills:</p>

                <input
                    type="checkbox"
                    id="html"
                    name="skills"
                    value="html"
                >

                <label for="html">HTML</label>

                <input
                    type="checkbox"
                    id="css"
                    name="skills"
                    value="css"
                >

                <label for="css">CSS</label>

                <br><br>


                <!-- select creates a dropdown menu -->
                <label for="course">Choose a course:</label>

                <select id="course" name="course">

                    <!-- option represents one choice -->
                    <option value="">-- Select --</option>
                    <option value="html">HTML</option>
                    <option value="css">CSS</option>
                    <option value="javascript">JavaScript</option>

                </select>

                <br><br>


                <!-- textarea allows multi-line text -->
                <label for="message">Message:</label><br>

                <textarea
                    id="message"
                    name="message"
                    rows="5"
                    cols="30"
                    placeholder="Write your message..."
                ></textarea>

                <br><br>


                <!-- submit sends the form -->
                <button type="submit">Submit</button>

                <!-- reset clears the form -->
                <button type="reset">Reset</button>

            </form>

        </section>


        <!-- =====================================================
             DETAILS AND SUMMARY
             ===================================================== -->
        <section>

            <h2>Frequently Asked Question</h2>

            <!-- details creates expandable content -->
            <details>

                <!-- summary is the clickable heading -->
                <summary>What is HTML?</summary>

                <p>
                    HTML is the standard markup language used
                    to structure content on the web.
                </p>

            </details>

        </section>


        <!-- =====================================================
             QUOTATION
             ===================================================== -->
        <section>

            <h2>Quote</h2>

            <!-- blockquote represents a longer quotation -->
            <blockquote>
                The web is for everyone.
            </blockquote>

            <!-- q represents a short inline quotation -->
            <p>
                Someone once said, <q>Keep learning.</q>
            </p>

        </section>


        <!-- =====================================================
             DIV AND SPAN
             ===================================================== -->
        <section>

            <h2>div and span</h2>

            <!--
                div is a generic block-level container.
                It is useful for grouping content.
            -->
            <div>

                <h3>Student Profile</h3>

                <!--
                    span is a generic inline container.
                    It is useful when you need to target
                    a small piece of text.
                -->
                <p>
                    My name is <span>Amar</span>.
                </p>

            </div>

        </section>


        <!-- =====================================================
             SEMANTIC HTML
             ===================================================== -->
        <section>

            <h2>Semantic Elements</h2>

            <article>

                <!--
                    article represents independent content
                    that could stand on its own.
                -->
                <h3>Learning HTML</h3>

                <p>
                    HTML is the foundation of web development.
                </p>

            </article>

            <aside>

                <!--
                    aside contains related or secondary content.
                -->
                <p>
                    Tip: Practice writing HTML without CSS first.
                </p>

            </aside>

        </section>


        <!-- =====================================================
             TIME
             ===================================================== -->
        <section>

            <h2>Time</h2>

            <!-- time represents a date or time in a machine-readable way -->
            <p>
                This lesson was published on
                <time datetime="2026-10-04">October 4, 2026</time>.
            </p>

        </section>


        <!-- =====================================================
             AUDIO
             ===================================================== -->
        <section>

            <h2>Audio</h2>

            <!--
                audio embeds sound.
                controls gives the user play/pause controls.
            -->
            <audio controls>

                <source src="audio.mp3" type="audio/mpeg">

                Your browser does not support audio.

            </audio>

        </section>


        <!-- =====================================================
             VIDEO
             ===================================================== -->
        <section>

            <h2>Video</h2>

            <!-- video embeds video content -->
            <video controls width="400">

                <source src="video.mp4" type="video/mp4">

                Your browser does not support video.

            </video>

        </section>


        <!-- =====================================================
             IFRAME
             ===================================================== -->
        <section>

            <h2>Embedded Content</h2>

            <!--
                iframe embeds another webpage/document
                inside the current webpage.
            -->
            <iframe
                src="https://example.com"
                title="Example webpage"
                width="400"
                height="200"
            ></iframe>

        </section>

    </main>


    <!-- =========================================================
         FOOTER
         Contains information at the bottom of the webpage.
         ========================================================= -->
    <footer>

        <hr>

        <p>
            &copy; 2026 HTML Learning Guide
        </p>

        <!-- Address can contain contact information -->
        <address>
            Contact: learner@example.com
        </address>

    </footer>

</body>
</html>